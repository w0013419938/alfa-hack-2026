# Образец настроек. Скопируйте в .env и измените при необходимости:
#   cp .env.example .env
# Без файла .env всё тоже запустится — docker-compose.yml содержит значения по умолчанию для демо.

# --- Режим и логи ---
APP_ENV=development            # production запрещает запуск с демо-секретом JWT
LOG_LEVEL=INFO

# --- База данных PostgreSQL ---
POSTGRES_DB=credit_cabinet
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit

# --- Авторизация ---
# Обязательно смените в любом окружении, кроме локального демо (минимум 16 символов)
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=5            # неудачных попыток входа...
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60     # ...за столько секунд, потом 429

# --- Фронтенд ---
CORS_ORIGINS=http://localhost:5173     # несколько адресов — через запятую

# --- Внешние сервисы (mock-external) ---
EXTERNAL_TIMEOUT_SECONDS=2             # сколько ждём ответа на одну попытку
EXTERNAL_MAX_ATTEMPTS=3                # сколько всего попыток
EXTERNAL_BACKOFF_SECONDS=0.5           # пауза перед повтором (удваивается с каждой попыткой)
MOCK_TIMEOUT_SLEEP_SECONDS=10          # сколько «зависает» мок в режиме сбоя timeout

# --- Пайплайн обработки заявки ---
PIPELINE_STEP_DELAY_SECONDS=1.5        # пауза между шагами, чтобы на демо было видно смену статусов
PIPELINE_WORKERS=4                     # сколько заявок обрабатывается параллельно
PIPELINE_WATCHDOG_INTERVAL_SECONDS=60  # как часто сторож ищет застрявшие заявки
PIPELINE_STUCK_AFTER_SECONDS=120       # сколько секунд без изменений считать «застряла»

# --- Загрузка документов ---
MAX_UPLOAD_MB=10
MAX_DOCUMENTS_PER_APPLICATION=20       # чтобы одной заявкой нельзя было заполнить диск
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png

# --- Порты на хосте ---
FRONTEND_PORT=3000                     # интерфейс: http://localhost:3000
BACKEND_PORT=8000
MOCK_EXTERNAL_PORT=8001
